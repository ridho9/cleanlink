# Paste the bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional. An R-18 pixiv work names its files only to a signed-in viewer, and
# the pages are read from the pixiv.re mirror when this is empty. Paste the
# `cookie:` request header from a logged-in pixiv.net tab to read them from
# pixiv itself instead.
PIXIV_COOKIE=
